ROLLBOARD_ADDR=127.0.0.1:8080
ROLLBOARD_DATABASE_URL=postgres://rollboard:rollboard@127.0.0.1:5432/rollboard?sslmode=disable
ROLLBOARD_DATABASE_MAX_CONNS=20
ROLLBOARD_REDIS_URL=redis://127.0.0.1:6379/0
ROLLBOARD_APP_ORIGIN=http://127.0.0.1:5173
ROLLBOARD_COOKIE_SECURE=false
# Credential attempts per minute, per source IP, per replica.
ROLLBOARD_AUTH_RATE_LIMIT=10
# Addresses or CIDR blocks whose X-Forwarded-For may be believed, comma
# separated. Set this to your reverse proxy: without it every visitor behind
# nginx shares one rate-limit budget, so one person's failed sign-ins lock out
# everybody else. Leave empty when the server is exposed directly — a header
# from a direct client is worthless.
ROLLBOARD_TRUSTED_PROXIES=
# Directory holding one <tag>.json translation catalog per language.
# Point this at a mounted volume to add a language without rebuilding the image.
ROLLBOARD_LOCALES_DIR=./locales
# Where author-uploaded images are stored. Leave unset to disable uploading.
ROLLBOARD_UPLOADS_DIR=./data/uploads
# How much one account's images may total, and how much this deployment stores.
# Content addressing stops the same picture costing twice; it does nothing about
# a thousand different ones, which is what these are for.
ROLLBOARD_UPLOAD_QUOTA_MB=50
ROLLBOARD_UPLOAD_TOTAL_MB=5000
# Uploads per minute, per account.
ROLLBOARD_UPLOAD_RATE_LIMIT=30
